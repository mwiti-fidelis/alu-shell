#!/usr/bin/env bash
# Create PID file
echo $$ > /var/run/myscript.pid

# Function to handle cleanup
cleanup() {
    rm -f /var/run/myscript.pid
    echo "Goodbye."
    exit 0
}

# Trap signals
trap 'echo "I hate the kill command"; cleanup' TERM
trap 'echo "Y U no love me?!"; cleanup' INT
trap 'cleanup' QUIT

# Infinite loop
while true; do
    echo "To infinity and beyond"
    sleep 2
done
